    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/eldenring#MessmerBoss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/eldenring#Boss"/>
        <rdfs:label>Мессмер</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/eldenring#PalePrinceBoss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/eldenring#Boss"/>
        <rdfs:label>Бледный принц</rdfs:label>
    </owl:Class>
    
    <owl:Class rdf:about="http://www.semanticweb.org/eldenring#QueenMalikBoss">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/eldenring#Boss"/>
        <rdfs:label>Королева Малик</rdfs:label>
    </owl:Class>

    <!-- Свойства -->
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eldenring#prefersPlaystyle">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eldenring#CharacterClass"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/eldenring#Playstyle"/>
        <rdfs:label>предпочитает стиль</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eldenring#hasAttribute">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eldenring#CharacterClass"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/eldenring#Attribute"/>
        <rdfs:label>имеет атрибут</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eldenring#hasDifficulty">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eldenring#Boss"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/eldenring#DifficultyLevel"/>
        <rdfs:label>имеет сложность</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eldenring#recommendedOrder">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eldenring#Boss"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>рекомендуемый порядок</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eldenring#recommendedWeapon">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eldenring#Playstyle"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/eldenring#Weapon"/>
        <rdfs:label>рекомендуемое оружие</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eldenring#recommendedSpell">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eldenring#Playstyle"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/eldenring#Spell"/>
        <rdfs:label>рекомендуемое заклинание</rdfs:label>
    </owl:ObjectProperty>
    
    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/eldenring#locatedIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/eldenring#Boss"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/eldenring#Location"/>
        <rdfs:label>находится в</rdfs:label>
    </owl:ObjectProperty>

    <!-- Уровни сложности -->
    <owl:Class rdf:about="http://www.semanticweb.org/eldenring#DifficultyLevel"/>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eldenring#LowDifficulty">
        <rdf:type rdf:resource="http://www.semanticweb.org/eldenring#DifficultyLevel"/>
        <rdfs:label>Низкая сложность</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eldenring#MediumDifficulty">
        <rdf:type rdf:resource="http://www.semanticweb.org/eldenring#DifficultyLevel"/>
        <rdfs:label>Средняя сложность</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eldenring#HighDifficulty">
        <rdf:type rdf:resource="http://www.semanticweb.org/eldenring#DifficultyLevel"/>
        <rdfs:label>Высокая сложность</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/eldenring#VeryHighDifficulty">
        <rdf:type rdf:resource="http://www.semanticweb.org/eldenring#DifficultyLevel"/>
        <rdfs:label>Очень высокая сложность</rdfs:label>
    </owl:NamedIndividual>
</rdf:RDF>